rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /publicBookMetadataV1/{aliasId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    match /publicBookCatalogIndexV1/{documentId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    match /publicBookMetadataOnDemandV1/{aliasId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    match /publicBookCatalogDeltaV1/{documentId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isCanonicalScope(scopeId) {
      return scopeId == 'local';
    }

    function boundedString(value, maxSize, allowEmpty) {
      return value is string
        && value.size() <= maxSize
        && (allowEmpty || value.size() > 0);
    }

    function validClientTime(value) {
      return value is int && value >= 0 && value <= 9007199254740991;
    }

    function validReadingActiveIntervals(data) {
      return !data.keys().hasAny(['activeIntervals'])
        ? data.durationMs == data.endedAtClient - data.startedAtClient
        : data.mode == 'tts'
          && data.activeIntervals is list
          && data.activeIntervals.size() > 0
          && data.activeIntervals.size() <= 512
          && data.activeIntervals[0] is map
          && data.activeIntervals[0].keys().hasOnly(['startedAtClient', 'endedAtClient'])
          && validClientTime(data.activeIntervals[0].startedAtClient)
          && validClientTime(data.activeIntervals[0].endedAtClient)
          && data.activeIntervals[0].startedAtClient == data.startedAtClient
          && data.activeIntervals[data.activeIntervals.size() - 1] is map
          && data.activeIntervals[data.activeIntervals.size() - 1].keys()
            .hasOnly(['startedAtClient', 'endedAtClient'])
          && validClientTime(
            data.activeIntervals[data.activeIntervals.size() - 1].startedAtClient
          )
          && validClientTime(
            data.activeIntervals[data.activeIntervals.size() - 1].endedAtClient
          )
          && data.activeIntervals[data.activeIntervals.size() - 1].endedAtClient
            == data.endedAtClient
          && data.durationMs <= data.endedAtClient - data.startedAtClient;
    }

    function validReadingSession(data, sessionId) {
      return data.keys().hasOnly([
          'schemaVersion', 'sessionId', 'bookId', 'bookTitle', 'deviceId',
          'mode', 'startedAtClient', 'endedAtClient', 'durationMs',
          'startProgressPercent', 'endProgressPercent', 'timezoneOffsetMinutes',
          'localDate', 'completed', 'uploadedAtServer', 'clockOffsetMs',
          'clockUncertaintyMs', 'clockMeasuredAtClient', 'activeIntervals',
          'completionConfirmedAtClient', 'completionRoundNumber'
        ])
        && data.schemaVersion == 1
        && data.sessionId == sessionId
        && boundedString(data.sessionId, 128, false)
        && !data.sessionId.matches('.*[/].*')
        && boundedString(data.bookId, 512, false)
        && boundedString(data.bookTitle, 1000, false)
        && boundedString(data.deviceId, 128, false)
        && (data.mode == 'screen' || data.mode == 'tts')
        && validClientTime(data.startedAtClient)
        && validClientTime(data.endedAtClient)
        && data.endedAtClient > data.startedAtClient
        && data.durationMs is int
        && validReadingActiveIntervals(data)
        && data.durationMs >= 1000
        && data.durationMs <= 300000
        && data.startProgressPercent is number
        && data.startProgressPercent >= 0
        && data.startProgressPercent <= 100
        && data.endProgressPercent is number
        && data.endProgressPercent >= 0
        && data.endProgressPercent <= 100
        && data.timezoneOffsetMinutes is int
        && data.timezoneOffsetMinutes >= -840
        && data.timezoneOffsetMinutes <= 840
        && boundedString(data.localDate, 10, false)
        && data.localDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.completed is bool
        && (
          !data.keys().hasAny(['completionConfirmedAtClient'])
          || (
            validClientTime(data.completionConfirmedAtClient)
            && data.completionConfirmedAtClient >= data.endedAtClient
            && data.completed == true
          )
        )
        && (
          !data.keys().hasAny(['completionRoundNumber'])
          || (
            data.completionRoundNumber is int
            && data.completionRoundNumber >= 1
            && data.completionRoundNumber <= 9007199254740991
            && data.keys().hasAll(['completionConfirmedAtClient'])
          )
        )
        && (
          !data.keys().hasAny(['clockOffsetMs', 'clockUncertaintyMs', 'clockMeasuredAtClient'])
          || (
            data.keys().hasAll(['clockOffsetMs', 'clockUncertaintyMs', 'clockMeasuredAtClient'])
            && data.clockOffsetMs is int
            && data.clockOffsetMs >= -86400000
            && data.clockOffsetMs <= 86400000
            && data.clockUncertaintyMs is int
            && data.clockUncertaintyMs >= 0
            && data.clockUncertaintyMs <= 5000
            && validClientTime(data.clockMeasuredAtClient)
          )
        )
        && data.uploadedAtServer == request.time;
    }

    function validPosition(position) {
      return position is map
        && position.keys().hasOnly(['cfi', 'anchorCfi', 'progressPercent'])
        && boundedString(position.cfi, 8192, false)
        && (position.anchorCfi == null || boundedString(position.anchorCfi, 8192, false))
        && position.progressPercent is number
        && position.progressPercent >= 0
        && position.progressPercent <= 100;
    }

    function validProgressHead(data, bookId) {
      return data.keys().hasOnly([
          'schemaVersion', 'bookId', 'revision', 'acceptedEventId', 'operation',
          'position', 'acceptedDeviceId', 'acceptedSessionId', 'occurredAtClient', 'updatedAtServer',
          'deletedAtServer'
        ])
        && data.schemaVersion == 2
        && data.bookId == bookId
        && boundedString(data.bookId, 512, false)
        && data.revision is int
        && data.revision >= 1
        && data.revision <= 9007199254740991
        && boundedString(data.acceptedEventId, 128, false)
        && boundedString(data.acceptedDeviceId, 128, false)
        && boundedString(data.acceptedSessionId, 128, false)
        && validClientTime(data.occurredAtClient)
        && data.updatedAtServer == request.time
        && (
          (data.operation == 'set' && validPosition(data.position) && data.deletedAtServer == null)
          ||
          (data.operation == 'reset' && data.position == null && data.deletedAtServer == request.time)
        );
    }

    function validBookmarkPayload(bookmark, bookmarkId) {
      return bookmark is map
        && bookmark.keys().hasOnly([
          'bookmarkId', 'cfi', 'name', 'color', 'progressPercent',
          'createdAtClient', 'updatedAtClient'
        ])
        && bookmark.bookmarkId == bookmarkId
        && boundedString(bookmark.bookmarkId, 128, false)
        && boundedString(bookmark.cfi, 8192, false)
        && boundedString(bookmark.name, 512, true)
        && boundedString(bookmark.color, 64, false)
        && (
          bookmark.progressPercent == null
          || (
            bookmark.progressPercent is number
            && bookmark.progressPercent >= 0
            && bookmark.progressPercent <= 100
          )
        )
        && validClientTime(bookmark.createdAtClient)
        && validClientTime(bookmark.updatedAtClient)
        && bookmark.updatedAtClient >= bookmark.createdAtClient;
    }

    function validBookmarkHead(data, bookId, bookmarkId) {
      return data.keys().hasOnly([
          'schemaVersion', 'bookId', 'bookmarkId', 'revision', 'acceptedEventId',
          'operation', 'bookmark', 'acceptedDeviceId', 'acceptedSessionId', 'occurredAtClient',
          'updatedAtServer', 'deletedAtServer'
        ])
        && data.schemaVersion == 2
        && data.bookId == bookId
        && data.bookmarkId == bookmarkId
        && boundedString(data.bookId, 512, false)
        && boundedString(data.bookmarkId, 128, false)
        && data.revision is int
        && data.revision >= 1
        && data.revision <= 9007199254740991
        && boundedString(data.acceptedEventId, 128, false)
        && boundedString(data.acceptedDeviceId, 128, false)
        && boundedString(data.acceptedSessionId, 128, false)
        && validClientTime(data.occurredAtClient)
        && data.updatedAtServer == request.time
        && (
          (
            data.operation == 'upsert'
            && validBookmarkPayload(data.bookmark, bookmarkId)
            && data.deletedAtServer == null
          )
          ||
          (data.operation == 'delete' && data.bookmark == null && data.deletedAtServer == request.time)
        );
    }

    function validHighlightColor(colorId) {
      return colorId == 'yellow'
        || colorId == 'green'
        || colorId == 'blue'
        || colorId == 'pink'
        || colorId == 'purple';
    }

    function validAnnotationPayload(annotation, bookId, annotationId) {
      return annotation is map
        && annotation.keys().hasOnly([
          'id', 'bookId', 'type', 'sectionIndex', 'rangeCfi', 'quote',
          'prefix', 'suffix', 'colorId', 'note', 'progressPercent', 'chapter',
          'createdAtClient', 'updatedAtClient'
        ])
        && annotation.id == annotationId
        && annotation.bookId == bookId
        && boundedString(annotation.id, 128, false)
        && annotation.id.matches('^[A-Za-z0-9_-]+$')
        && boundedString(annotation.bookId, 512, false)
        && annotation.type == 'highlight'
        && annotation.sectionIndex is int
        && annotation.sectionIndex >= 0
        && annotation.sectionIndex <= 9007199254740991
        && boundedString(annotation.rangeCfi, 16000, false)
        && annotation.rangeCfi.matches('^epubcfi\\(.+\\)$')
        && boundedString(annotation.quote, 4000, false)
        && annotation.quote.matches('\\s*\\S(\\s|\\S)*')
        && boundedString(annotation.prefix, 80, true)
        && boundedString(annotation.suffix, 80, true)
        && validHighlightColor(annotation.colorId)
        && boundedString(annotation.note, 4000, true)
        && (
          annotation.progressPercent == null
          || (
            annotation.progressPercent is number
            && annotation.progressPercent >= 0
            && annotation.progressPercent <= 100
          )
        )
        && boundedString(annotation.chapter, 500, true)
        && validClientTime(annotation.createdAtClient)
        && annotation.createdAtClient > 0
        && validClientTime(annotation.updatedAtClient)
        && annotation.updatedAtClient >= annotation.createdAtClient;
    }

    function validAnnotationHead(data, bookId, annotationId) {
      return data.keys().hasOnly([
          'schemaVersion', 'bookId', 'annotationId', 'revision',
          'acceptedEventId', 'operation', 'annotation', 'acceptedDeviceId',
          'acceptedSessionId', 'occurredAtClient', 'updatedAtServer',
          'deletedAtServer', 'bookGeneration'
        ])
        && data.schemaVersion == 1
        && data.bookId == bookId
        && data.annotationId == annotationId
        && boundedString(data.bookId, 512, false)
        && boundedString(data.annotationId, 128, false)
        && data.revision is int
        && data.revision >= 1
        && data.revision <= 9007199254740991
        && boundedString(data.acceptedEventId, 128, false)
        && boundedString(data.acceptedDeviceId, 128, false)
        && boundedString(data.acceptedSessionId, 128, false)
        && validClientTime(data.occurredAtClient)
        && validClientTime(data.get('bookGeneration', 0))
        && data.updatedAtServer == request.time
        && (
          (
            data.operation == 'upsert'
            && validAnnotationPayload(data.annotation, bookId, annotationId)
            && data.deletedAtServer == null
          )
          ||
          (
            data.operation == 'delete'
            && data.annotation == null
            && data.deletedAtServer == request.time
          )
        );
    }

    function validAnnotationAggregate(data, bookId) {
      return data.keys().hasOnly([
          'schemaVersion', 'bookId', 'revision', 'totalCount', 'colorCounts',
          'entries', 'rangeCfis', 'acceptedEventId', 'acceptedAnnotationId',
          'acceptedOperation', 'updatedAtServer'
        ])
        && data.schemaVersion == 1
        && data.bookId == bookId
        && boundedString(data.bookId, 512, false)
        && data.revision is int
        && data.revision >= 1
        && data.revision <= 9007199254740991
        && data.totalCount is int
        && data.totalCount >= 0
        && data.totalCount <= 100
        && data.colorCounts is map
        && data.colorCounts.keys().hasOnly(['yellow', 'green', 'blue', 'pink', 'purple'])
        && data.colorCounts.yellow is int
        && data.colorCounts.yellow >= 0
        && data.colorCounts.yellow <= 20
        && data.colorCounts.green is int
        && data.colorCounts.green >= 0
        && data.colorCounts.green <= 20
        && data.colorCounts.blue is int
        && data.colorCounts.blue >= 0
        && data.colorCounts.blue <= 20
        && data.colorCounts.pink is int
        && data.colorCounts.pink >= 0
        && data.colorCounts.pink <= 20
        && data.colorCounts.purple is int
        && data.colorCounts.purple >= 0
        && data.colorCounts.purple <= 20
        && data.colorCounts.yellow
          + data.colorCounts.green
          + data.colorCounts.blue
          + data.colorCounts.pink
          + data.colorCounts.purple == data.totalCount
        && data.entries is map
        && data.entries.size() == data.totalCount
        && data.rangeCfis is list
        && data.rangeCfis.size() == data.totalCount
        && data.rangeCfis.toSet().size() == data.totalCount
        && boundedString(data.acceptedEventId, 128, false)
        && boundedString(data.acceptedAnnotationId, 128, false)
        && data.acceptedAnnotationId.matches('^[A-Za-z0-9_-]+$')
        && (data.acceptedOperation == 'upsert' || data.acceptedOperation == 'delete')
        && data.updatedAtServer == request.time;
    }

    function validPaletteItem(item, colorId) {
      return item is map
        && item.keys().hasOnly(['id', 'label', 'meaning'])
        && item.id == colorId
        && boundedString(item.label, 24, false)
        && boundedString(item.meaning, 80, true);
    }

    function validAnnotationPalette(palette) {
      return palette is map
        && palette.keys().hasOnly(['items'])
        && palette.items is list
        && palette.items.size() == 5
        && validPaletteItem(palette.items[0], 'yellow')
        && validPaletteItem(palette.items[1], 'green')
        && validPaletteItem(palette.items[2], 'blue')
        && validPaletteItem(palette.items[3], 'pink')
        && validPaletteItem(palette.items[4], 'purple');
    }

    function validAnnotationPaletteHead(data) {
      return data.keys().hasOnly([
          'schemaVersion', 'revision', 'acceptedEventId', 'operation',
          'palette', 'acceptedDeviceId', 'acceptedSessionId',
          'occurredAtClient', 'updatedAtServer'
        ])
        && data.schemaVersion == 1
        && data.revision is int
        && data.revision >= 1
        && data.revision <= 9007199254740991
        && boundedString(data.acceptedEventId, 128, false)
        && data.operation == 'set'
        && validAnnotationPalette(data.palette)
        && boundedString(data.acceptedDeviceId, 128, false)
        && boundedString(data.acceptedSessionId, 128, false)
        && validClientTime(data.occurredAtClient)
        && data.updatedAtServer == request.time;
    }

    function receiptPath(appId, uid, scopeId, bookId, eventId) {
      return /databases/$(database)/documents/artifacts/$(appId)/users/$(uid)/libraries/$(scopeId)/readingHistoryV2/$(bookId)/eventReceipts/$(eventId);
    }

    function matchingReceiptAfter(appId, uid, scopeId, data, targetKind, bookmarkId, targetKey) {
      let receipt = getAfter(receiptPath(appId, uid, scopeId, data.bookId, data.acceptedEventId)).data;
      return receipt.schemaVersion == 2
        && receipt.eventId == data.acceptedEventId
        && receipt.targetKind == targetKind
        && receipt.bookId == data.bookId
        && receipt.bookmarkId == bookmarkId
        && receipt.targetKey == targetKey
        && receipt.revision == data.revision
        && receipt.createdAtServer == request.time;
    }

    function annotationReceiptPath(appId, uid, scopeId, bookId, eventId) {
      return /databases/$(database)/documents/artifacts/$(appId)/users/$(uid)/libraries/$(scopeId)/annotationSyncV1/$(bookId)/eventReceipts/$(eventId);
    }

    function annotationAggregatePath(appId, uid, scopeId, bookId) {
      return /databases/$(database)/documents/artifacts/$(appId)/users/$(uid)/libraries/$(scopeId)/annotationSyncV1/$(bookId);
    }

    function annotationBookDeleteMarkerPath(appId, uid, scopeId, bookId) {
      return /databases/$(database)/documents/artifacts/$(appId)/users/$(uid)/libraries/$(scopeId)/annotationSyncV1/$(bookId)/annotations/book_delete_marker_v1;
    }

    function allowedByAnnotationBookDeleteMarker(appId, uid, scopeId, data, annotationId) {
      let markerPath = annotationBookDeleteMarkerPath(appId, uid, scopeId, data.bookId);
      let currentGeneration = existsAfter(markerPath)
        ? getAfter(markerPath).data.revision
        : 0;
      return (
          data.operation == 'delete'
          && (
            annotationId != 'book_delete_marker_v1'
            || data.get('bookGeneration', 0) == data.revision
          )
        ) || (
          data.operation == 'upsert'
          &&
          annotationId != 'book_delete_marker_v1'
          && data.get('bookGeneration', 0) == currentGeneration
        );
    }

    function matchingAnnotationAggregateAfter(appId, uid, scopeId, data, annotationId) {
      let aggregate = getAfter(annotationAggregatePath(
        appId, uid, scopeId, data.bookId
      )).data;
      return aggregate.acceptedEventId == data.acceptedEventId
        && aggregate.acceptedAnnotationId == annotationId
        && aggregate.acceptedOperation == data.operation
        && (
          (
            data.operation == 'upsert'
            && aggregate.entries[annotationId].rangeCfi == data.annotation.rangeCfi
            && aggregate.entries[annotationId].colorId == data.annotation.colorId
            && aggregate.rangeCfis.hasAny([data.annotation.rangeCfi])
          )
          || (
            data.operation == 'delete'
            && !aggregate.entries.keys().hasAny([annotationId])
          )
        );
    }

    function matchingAnnotationHeadAfter(appId, uid, scopeId, aggregate) {
      let head = getAfter(/databases/$(database)/documents/artifacts/$(appId)/users/$(uid)/libraries/$(scopeId)/annotationSyncV1/$(aggregate.bookId)/annotations/$(aggregate.acceptedAnnotationId)).data;
      return head.acceptedEventId == aggregate.acceptedEventId
        && head.operation == aggregate.acceptedOperation
        && head.updatedAtServer == request.time;
    }

    function initialAnnotationAggregateMatchesHead(appId, uid, scopeId, aggregate) {
      let head = getAfter(/databases/$(database)/documents/artifacts/$(appId)/users/$(uid)/libraries/$(scopeId)/annotationSyncV1/$(aggregate.bookId)/annotations/$(aggregate.acceptedAnnotationId)).data;
      return (
          head.operation == 'delete'
          && aggregate.totalCount == 0
        ) || (
          head.operation == 'upsert'
          && aggregate.totalCount == 1
          && aggregate.colorCounts[head.annotation.colorId] == 1
        );
    }

    function annotationColorCountDeltaIsExact(before, after, colorId) {
      let annotationId = after.acceptedAnnotationId;
      let existedBefore = before.entries.keys().hasAny([annotationId]);
      let existsAfter = after.entries.keys().hasAny([annotationId]);
      let removed = existedBefore && before.entries[annotationId].colorId == colorId ? 1 : 0;
      let added = existsAfter && after.entries[annotationId].colorId == colorId ? 1 : 0;
      return after.colorCounts[colorId] == before.colorCounts[colorId] - removed + added;
    }

    function annotationAggregateUpdateIsScoped(before, after) {
      let annotationId = after.acceptedAnnotationId;
      let existedBefore = before.entries.keys().hasAny([annotationId]);
      let existsAfter = after.entries.keys().hasAny([annotationId]);
      let beforeRange = existedBefore ? before.entries[annotationId].rangeCfi : '';
      let afterRange = existsAfter ? after.entries[annotationId].rangeCfi : '';
      let changedRanges = before.rangeCfis.toSet().difference(after.rangeCfis.toSet())
        .union(after.rangeCfis.toSet().difference(before.rangeCfis.toSet()));
      return after.entries.diff(before.entries).affectedKeys().hasOnly([annotationId])
        && changedRanges.hasOnly([beforeRange, afterRange])
        && after.colorCounts.diff(before.colorCounts).affectedKeys().hasOnly([
          existedBefore ? before.entries[annotationId].colorId : '',
          existsAfter ? after.entries[annotationId].colorId : ''
        ])
        && annotationColorCountDeltaIsExact(before, after, 'yellow')
        && annotationColorCountDeltaIsExact(before, after, 'green')
        && annotationColorCountDeltaIsExact(before, after, 'blue')
        && annotationColorCountDeltaIsExact(before, after, 'pink')
        && annotationColorCountDeltaIsExact(before, after, 'purple')
        && (
          (
            after.acceptedOperation == 'upsert'
            && after.totalCount == before.totalCount + (existedBefore ? 0 : 1)
          )
          || (
            after.acceptedOperation == 'delete'
            && after.totalCount == before.totalCount - (existedBefore ? 1 : 0)
          )
        );
    }

    function matchingAnnotationReceiptAfter(appId, uid, scopeId, data, annotationId) {
      let receipt = getAfter(annotationReceiptPath(
        appId, uid, scopeId, data.bookId, data.acceptedEventId
      )).data;
      return receipt.schemaVersion == 1
        && receipt.eventId == data.acceptedEventId
        && receipt.targetKind == 'annotation'
        && receipt.bookId == data.bookId
        && receipt.annotationId == annotationId
        && receipt.targetKey == 'annotation:' + data.bookId + ':' + annotationId
        && receipt.revision == data.revision
        && receipt.createdAtServer == request.time;
    }

    function paletteReceiptPath(appId, uid, scopeId, eventId) {
      return /databases/$(database)/documents/artifacts/$(appId)/users/$(uid)/libraries/$(scopeId)/annotationSettingsV1/palette/eventReceipts/$(eventId);
    }

    function matchingPaletteReceiptAfter(appId, uid, scopeId, data) {
      let receipt = getAfter(paletteReceiptPath(
        appId, uid, scopeId, data.acceptedEventId
      )).data;
      return receipt.schemaVersion == 1
        && receipt.eventId == data.acceptedEventId
        && receipt.targetKind == 'palette'
        && receipt.bookId == null
        && receipt.annotationId == null
        && receipt.targetKey == 'annotation-palette'
        && receipt.revision == data.revision
        && receipt.createdAtServer == request.time;
    }

    match /artifacts/{appId}/users/{uid}/libraries/{scopeId}/readingHistoryV2/{bookId} {
      allow read: if owns(uid) && isCanonicalScope(scopeId);
      allow create: if owns(uid) && isCanonicalScope(scopeId)
        && validProgressHead(request.resource.data, bookId)
        && request.resource.data.revision == 1
        && matchingReceiptAfter(
          appId, uid, scopeId, request.resource.data,
          'progress', null, 'progress:' + bookId
        );
      allow update: if owns(uid) && isCanonicalScope(scopeId)
        && validProgressHead(request.resource.data, bookId)
        && request.resource.data.revision == resource.data.revision + 1
        && matchingReceiptAfter(
          appId, uid, scopeId, request.resource.data,
          'progress', null, 'progress:' + bookId
        );
      allow delete: if false;

      match /bookmarks/{bookmarkId} {
        allow read: if owns(uid) && isCanonicalScope(scopeId);
        allow create: if owns(uid) && isCanonicalScope(scopeId)
          && validBookmarkHead(request.resource.data, bookId, bookmarkId)
          && request.resource.data.revision == 1
          && matchingReceiptAfter(
            appId, uid, scopeId, request.resource.data,
            'bookmark', bookmarkId, 'bookmark:' + bookId + ':' + bookmarkId
          );
        allow update: if owns(uid) && isCanonicalScope(scopeId)
          && validBookmarkHead(request.resource.data, bookId, bookmarkId)
          && request.resource.data.revision == resource.data.revision + 1
          && matchingReceiptAfter(
            appId, uid, scopeId, request.resource.data,
            'bookmark', bookmarkId, 'bookmark:' + bookId + ':' + bookmarkId
          );
        allow delete: if false;
      }

      match /eventReceipts/{eventId} {
        allow read: if owns(uid) && isCanonicalScope(scopeId);
        allow create: if owns(uid) && isCanonicalScope(scopeId)
          && request.resource.data.keys().hasOnly([
            'schemaVersion', 'eventId', 'targetKind', 'bookId', 'bookmarkId',
            'targetKey', 'revision', 'createdAtServer'
          ])
          && request.resource.data.schemaVersion == 2
          && request.resource.data.eventId == eventId
          && request.resource.data.bookId == bookId
          && request.resource.data.revision is int
          && request.resource.data.revision >= 1
          && request.resource.data.revision <= 9007199254740991
          && request.resource.data.createdAtServer == request.time
          && (
            (
              request.resource.data.targetKind == 'progress'
              && request.resource.data.bookmarkId == null
              && request.resource.data.targetKey == 'progress:' + bookId
              && getAfter(/databases/$(database)/documents/artifacts/$(appId)/users/$(uid)/libraries/$(scopeId)/readingHistoryV2/$(bookId)).data.acceptedEventId == eventId
              && getAfter(/databases/$(database)/documents/artifacts/$(appId)/users/$(uid)/libraries/$(scopeId)/readingHistoryV2/$(bookId)).data.revision == request.resource.data.revision
            )
            ||
            (
              request.resource.data.targetKind == 'bookmark'
              && boundedString(request.resource.data.bookmarkId, 128, false)
              && request.resource.data.targetKey == 'bookmark:' + bookId + ':' + request.resource.data.bookmarkId
              && getAfter(/databases/$(database)/documents/artifacts/$(appId)/users/$(uid)/libraries/$(scopeId)/readingHistoryV2/$(bookId)/bookmarks/$(request.resource.data.bookmarkId)).data.acceptedEventId == eventId
              && getAfter(/databases/$(database)/documents/artifacts/$(appId)/users/$(uid)/libraries/$(scopeId)/readingHistoryV2/$(bookId)/bookmarks/$(request.resource.data.bookmarkId)).data.revision == request.resource.data.revision
            )
          );
        allow update, delete: if false;
      }
    }

    match /artifacts/{appId}/users/{uid}/libraries/{scopeId}/readingStatsV1/{sessionId} {
      allow read: if owns(uid) && isCanonicalScope(scopeId);
      allow create: if owns(uid) && isCanonicalScope(scopeId)
        && validReadingSession(request.resource.data, sessionId);
      allow update, delete: if false;
    }

    match /artifacts/{appId}/users/{uid}/libraries/{scopeId}/annotationSyncV1/{bookId} {
      allow read: if owns(uid) && isCanonicalScope(scopeId);
      allow create: if owns(uid) && isCanonicalScope(scopeId)
        && validAnnotationAggregate(request.resource.data, bookId)
        && request.resource.data.revision == 1
        && request.resource.data.totalCount <= 1
        && initialAnnotationAggregateMatchesHead(
          appId, uid, scopeId, request.resource.data
        )
        && matchingAnnotationHeadAfter(appId, uid, scopeId, request.resource.data);
      allow update: if owns(uid) && isCanonicalScope(scopeId)
        && validAnnotationAggregate(request.resource.data, bookId)
        && request.resource.data.revision == resource.data.revision + 1
        && annotationAggregateUpdateIsScoped(resource.data, request.resource.data)
        && matchingAnnotationHeadAfter(appId, uid, scopeId, request.resource.data);
      allow delete: if false;
    }

    match /artifacts/{appId}/users/{uid}/libraries/{scopeId}/annotationSyncV1/{bookId}/annotations/{annotationId} {
      allow read: if owns(uid) && isCanonicalScope(scopeId);
      allow create: if owns(uid) && isCanonicalScope(scopeId)
        && validAnnotationHead(request.resource.data, bookId, annotationId)
        && allowedByAnnotationBookDeleteMarker(
          appId, uid, scopeId, request.resource.data, annotationId
        )
        && request.resource.data.revision == 1
        && matchingAnnotationAggregateAfter(
          appId, uid, scopeId, request.resource.data, annotationId
        )
        && matchingAnnotationReceiptAfter(
          appId, uid, scopeId, request.resource.data, annotationId
        );
      allow update: if owns(uid) && isCanonicalScope(scopeId)
        && validAnnotationHead(request.resource.data, bookId, annotationId)
        && allowedByAnnotationBookDeleteMarker(
          appId, uid, scopeId, request.resource.data, annotationId
        )
        && request.resource.data.revision == resource.data.revision + 1
        && matchingAnnotationAggregateAfter(
          appId, uid, scopeId, request.resource.data, annotationId
        )
        && matchingAnnotationReceiptAfter(
          appId, uid, scopeId, request.resource.data, annotationId
        );
      allow delete: if false;
    }

    match /artifacts/{appId}/users/{uid}/libraries/{scopeId}/annotationSyncV1/{bookId}/eventReceipts/{eventId} {
      allow read: if owns(uid) && isCanonicalScope(scopeId);
      allow create: if owns(uid) && isCanonicalScope(scopeId)
        && request.resource.data.keys().hasOnly([
          'schemaVersion', 'eventId', 'targetKind', 'bookId', 'annotationId',
          'targetKey', 'revision', 'createdAtServer'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.eventId == eventId
        && request.resource.data.targetKind == 'annotation'
        && request.resource.data.bookId == bookId
        && boundedString(request.resource.data.annotationId, 128, false)
        && request.resource.data.targetKey == 'annotation:' + bookId + ':' + request.resource.data.annotationId
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1
        && request.resource.data.revision <= 9007199254740991
        && request.resource.data.createdAtServer == request.time
        && getAfter(/databases/$(database)/documents/artifacts/$(appId)/users/$(uid)/libraries/$(scopeId)/annotationSyncV1/$(bookId)/annotations/$(request.resource.data.annotationId)).data.acceptedEventId == eventId
        && getAfter(/databases/$(database)/documents/artifacts/$(appId)/users/$(uid)/libraries/$(scopeId)/annotationSyncV1/$(bookId)/annotations/$(request.resource.data.annotationId)).data.revision == request.resource.data.revision;
      allow update, delete: if false;
    }

    match /artifacts/{appId}/users/{uid}/libraries/{scopeId}/annotationSettingsV1/palette {
      allow read: if owns(uid) && isCanonicalScope(scopeId);
      allow create: if owns(uid) && isCanonicalScope(scopeId)
        && validAnnotationPaletteHead(request.resource.data)
        && request.resource.data.revision == 1
        && matchingPaletteReceiptAfter(appId, uid, scopeId, request.resource.data);
      allow update: if owns(uid) && isCanonicalScope(scopeId)
        && validAnnotationPaletteHead(request.resource.data)
        && request.resource.data.revision == resource.data.revision + 1
        && matchingPaletteReceiptAfter(appId, uid, scopeId, request.resource.data);
      allow delete: if false;

      match /eventReceipts/{eventId} {
        allow read: if owns(uid) && isCanonicalScope(scopeId);
        allow create: if owns(uid) && isCanonicalScope(scopeId)
          && request.resource.data.keys().hasOnly([
            'schemaVersion', 'eventId', 'targetKind', 'bookId', 'annotationId',
            'targetKey', 'revision', 'createdAtServer'
          ])
          && request.resource.data.schemaVersion == 1
          && request.resource.data.eventId == eventId
          && request.resource.data.targetKind == 'palette'
          && request.resource.data.bookId == null
          && request.resource.data.annotationId == null
          && request.resource.data.targetKey == 'annotation-palette'
          && request.resource.data.revision is int
          && request.resource.data.revision >= 1
          && request.resource.data.revision <= 9007199254740991
          && request.resource.data.createdAtServer == request.time
          && getAfter(/databases/$(database)/documents/artifacts/$(appId)/users/$(uid)/libraries/$(scopeId)/annotationSettingsV1/palette).data.acceptedEventId == eventId
          && getAfter(/databases/$(database)/documents/artifacts/$(appId)/users/$(uid)/libraries/$(scopeId)/annotationSettingsV1/palette).data.revision == request.resource.data.revision;
        allow update, delete: if false;
      }
    }
  }
}
